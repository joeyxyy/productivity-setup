{
  "name": "productivity-setup",
  "version": "0.4.1",
  "description": "A responsive desk-health timer for sit, stand, walk, eye break, and stretch routines.",
  "author": "Yousef",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-packager . \"Productivity Setup\" --platform=win32 --arch=x64 --out=desktop-build --overwrite --ignore=\"^/(?!dist|electron|package\\.json)\"",
    "desktop:dist": "npm run build && electron-builder",
    "package": "npm run build && node scripts/package-web.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "build": {
    "appId": "com.joeyxyy.productivitysetup",
    "productName": "Productivity Setup",
    "directories": {
      "output": "desktop-build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
